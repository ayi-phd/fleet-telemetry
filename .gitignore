# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
# Written by deploy.sh; holds region and image tag for destroy.sh
deploy.auto.tfvars.json
*.tfvars
!example.tfvars
# Fetched from a running Floci by deploy.sh (TARGET=floci); not the committed AWS CA
terraform/platform/floci-ca.pem
# A Floci-local IAM access key, meaningless outside that Floci instance
.floci-deploy-key
# Local Terraform provider mirror for fully-offline Floci deploys/destroys, and the
# CLI config pointing at it; built by deploy.sh on first use, machine-specific
.floci-provider-mirror/
.floci.tfrc

# Build output
.build-*.log
services/gen/
web/node_modules/
web/dist/

# macOS Finder
.DS_Store
